# Copy to .env. Do not commit .env.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/website_manager"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://127.0.0.1:3210"

# Local development only. Never enable this in production.
AUTH_DEV_MODE="true"

# Microsoft Entra External ID. Leave blank until the app registration exists.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# GitHub App. The private key stays on the server. Never commit it.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""

# Optional local clone of 4EOSWeb/quantum-age. The hub clones GitHub when this is empty.
SITE_SOURCE_DIR=""
