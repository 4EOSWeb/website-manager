{
  "name": "4eos-website-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3210",
    "build": "next build",
    "start": "next start --port 3210",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "verify": "node --experimental-strip-types scripts/verify-slice.ts",
    "test": "node --experimental-strip-types --no-warnings --import ./tests/unit/resolve-ts.mjs --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "overlay:sync": "node --experimental-strip-types --no-warnings scripts/sync-overlay.ts",
    "routes": "node --experimental-strip-types --no-warnings scripts/route-inventory.ts --write",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@octokit/app": "^16.1.4",
    "@octokit/auth-app": "^8.1.1",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.1.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "lucide-react": "^0.544.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
